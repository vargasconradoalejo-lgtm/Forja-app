function sFor(y){
 for(let i=1;i<FEM.length;i++){if(y<=FEM[i][0]){const a=FEM[i-1],b=FEM[i],t=(y-a[0])/(b[0]-a[0]);return a[1]+(b[1]-a[1])*t;}}
 return FEM[FEM.length-1][1];
}
function mapP(d,g){
 if(g!=='f')return d;
 return d.replace(/(-?[\d.]+),(-?[\d.]+)/g,(m,x,y)=>{
  x=parseFloat(x);const dist=100-x,w=Math.min(1,Math.max(0,(dist-40)/12));
  const k=sFor(parseFloat(y))*(1-w)+0.9*w;
  return (100-dist*k).toFixed(1)+','+y;
 });
}
