/* ---------- music (generated samples; the real app needs licensed tracks) ---------- */
const TRACKS={
 energy:{n:'Energía',bpm:128,root:55,k:'x...x...x...x...',h:'..x...x...x...x.',b:'x..x..x.x..x..x.',notes:[0,0,7,5]},
 power:{n:'Fuerza',bpm:100,root:49,k:'x.....x.x.......',h:'....x.......x...',b:'x.....x.x.....x.',notes:[0,3,0,5]},
 cardio:{n:'Cardio',bpm:140,root:58.27,k:'x...x...x...x...',h:'x.x.x.x.x.x.x.x.',b:'.x..x..x.x..x..x',notes:[0,0,5,7]},
 calm:{n:'Calma',bpm:80,root:65.41,k:'x.......x.......',h:'..x...x...x...x.',b:'x.......x.......',notes:[0,5,3,7]}
};
const Music={ctx:null,master:null,noise:null,id:null,timer:null,step:0,
 hit(T,s){const c=this.ctx,t=c.currentTime,m=this.master;
  if(T.k[s]==='x'){const o=c.createOscillator(),g=c.createGain();o.type='sine';o.frequency.setValueAtTime(150,t);o.frequency.exponentialRampToValueAtTime(40,t+.12);g.gain.setValueAtTime(.8,t);g.gain.exponentialRampToValueAtTime(.001,t+.18);o.connect(g);g.connect(m);o.start(t);o.stop(t+.2);}
  if(T.h[s]==='x'){const n=c.createBufferSource(),f=c.createBiquadFilter(),g=c.createGain();n.buffer=this.noise;f.type='highpass';f.frequency.value=7000;g.gain.setValueAtTime(.25,t);g.gain.exponentialRampToValueAtTime(.001,t+.05);n.connect(f);f.connect(g);g.connect(m);n.start(t);n.stop(t+.06);}
  if(T.b[s]==='x'){const o=c.createOscillator(),f=c.createBiquadFilter(),g=c.createGain();o.type='sawtooth';o.frequency.value=T.root*Math.pow(2,T.notes[Math.floor(s/4)]/12);f.type='lowpass';f.frequency.value=500;g.gain.setValueAtTime(.001,t);g.gain.exponentialRampToValueAtTime(.35,t+.01);g.gain.exponentialRampToValueAtTime(.001,t+.22);o.connect(f);f.connect(g);g.connect(m);o.start(t);o.stop(t+.25);}
 },
 play(id){this.stop();const T=TRACKS[id];if(!T)return;
  try{
   if(!this.ctx){const C=window.AudioContext||window.webkitAudioContext;this.ctx=new C();this.master=this.ctx.createGain();this.master.gain.value=.5;this.master.connect(this.ctx.destination);
    const n=this.ctx.createBuffer(1,2048,this.ctx.sampleRate),d=n.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;this.noise=n;}
   if(this.ctx.state==='suspended')this.ctx.resume();
  }catch(e){return;}
  this.id=id;this.step=0;const tick=()=>{this.hit(T,this.step%16);this.step++;};tick();this.timer=setInterval(tick,60/T.bpm/4*1000);},
 stop(){clearInterval(this.timer);this.timer=null;this.id=null;}
};

