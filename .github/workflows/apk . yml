  case 'done':{const x=EX.find(z=>z.id===S.exId),firstToday=!trained(0);S.doneEx.add(x.id);logToday(x);x.m.forEach(k=>S.done.add(k));toast(firstToday?'Racha de '+myStats().streak+' días. Tus amigos la ven.':'Músculos agregados a tu perfil');render();break;}
  case 'social':S.via=arg;S.view='setup';render();break;
  case 'vs':S.vsId=arg;S.view='vs';render();break;
  case 'challenge':{push(arg,'m','¡Te reto! A ver quién mantiene la racha esta semana.');setTimeout(()=>push(arg,'t',arg==='camila'?'Acepto. Esta semana no me ganas.':'Dale, ya me puse las zapatillas.'),900);toast('Reto enviado a '+first(arg));break;}
  case 'goprofile':S.view='me';render();break;
  case 'chat':S.chat=arg;S.view='chat';render();break;
  case 'send':send();break;
  case 'call':startCall();break;
  case 'hang':endCall();break;
  case 'coachapply':coachApply();break;
  case 'plandel':{const [k,i]=arg.split('@');(S.plan[k]||[]).splice(+i,1);if(S.plan[k]&&!S.plan[k].length)delete S.plan[k];renderSheet();render();break;}
  case 'appeal':S.banned=false;S.view='ex';render();toast('Apelación enviada (demo)');break;
  case 'g':S.gender=arg;render();break;
  case 'reggen':S.gender=arg;document.querySelectorAll('#genSeg button').forEach(x=>x.classList.toggle('on',x===b));break;
  case 'clear':S.done=new Set();S.doneEx=new Set();render();break;
  case 'edit':S.sheet='edit';render();break;
  case 'settings':S.sheet='set';render();break;
  case 'close':Music.stop();S.playing=null;document.querySelectorAll('.mchip.pl').forEach(x=>x.classList.remove('pl'));S.sheet=null;renderSheet();break;
  case 'feed':S.feed=arg;S.fReset=true;Music.stop();S.playing=null;render();break;
  case 'play':{const p=S.posts.find(x=>x.id===arg);if(!p||!p.tr)break;document.querySelectorAll('.mchip').forEach(x=>x.classList.remove('pl'));
   if(S.playing===arg){Music.stop();S.playing=null;}else{Music.play(p.tr);S.playing=arg;const c=b.closest('.post').querySelector('.mchip');if(c)c.classList.add('pl');}break;}
  case 'like':{if(S.liked.has(arg))S.liked.delete(arg);else S.liked.add(arg);const p=S.posts.find(x=>x.id===arg);
   document.querySelectorAll('[data-act="like:'+arg+'"]').forEach(x=>{x.classList.toggle('on',S.liked.has(arg));x.querySelector('span').textContent=fmtN(p.likes+(S.liked.has(arg)?1:0));});break;}
  case 'follow':{if(S.following.has(arg))S.following.delete(arg);else S.following.add(arg);
   document.querySelectorAll('.fb[data-act="follow:'+arg+'"]').forEach(x=>x.textContent=S.following.has(arg)?'✓':'+');toast(S.following.has(arg)?'Sigues a @'+unameOf(arg):'Dejaste de seguir a @'+unameOf(arg));break;}
  case 'share':toast('Enlace copiado (demo)');break;
  case 'ad':toast('Demo: aquí se abriría la página del anunciante');break;
  case 'cm':S.cmId=arg;S.sheet='cm';renderSheet();break;
  case 'cmsend':{const p=S.posts.find(x=>x.id===S.cmId),i=$('#cmIn');if(!p||!i)break;const v=i.value.trim();if(!v)break;p.cm.push({u:'me',t:v});
   const em=$('#cmEmpty');if(em)em.remove();$('#cmList').insertAdjacentHTML('beforeend',cmHtml({u:'me',t:v}));i.value='';
   document.querySelectorAll('[data-act="cm:'+p.id+'"] span').forEach(x=>x.textContent=p.cm.length);break;}
  case 'trk':S.np.tr=arg||null;if(arg)Music.play(arg);else Music.stop();renderSheet();break;
  case 'publish':{const n=S.np;if(!n||!n.media){toast('Elige una foto o un video');break;}
   S.posts.unshift({id:'p'+Date.now(),u:'me',k:n.mk==='video'?'video':'photo',media:n.media,mk:n.mk,txt:n.txt||'Mi entrenamiento de hoy',tr:n.tr,likes:0,cm:[]});
   Music.stop();S.playing=null;S.sheet=null;S.view='feed';S.feed='foryou';S.fReset=true;render();toast('Publicado en Inicio');break;}
  case 'calprev':S.calM--;if(S.calM<0){S.calM=11;S.calY--;}render();break;
  case 'calnext':S.calM++;if(S.calM>11){S.calM=0;S.calY++;}render();break;
  case 'calpub':S.calPub=arg==='1';render();toast(S.calPub?'Tu calendario es público':'Tu calendario es privado');break;
  case 'day':{S.day=arg;const e=S.cal[arg];S.draft=e?{what:e.what,ex:[...e.ex],photo:e.photo,note:e.note||'',share:false}:{what:'',ex:[],photo:null,note:'',share:S.calPub};S.sheet='day';renderSheet();break;}
  case 'what':S.draft.what=S.draft.what===arg?'':arg;document.querySelectorAll('#dayWhat button').forEach(x=>x.classList.toggle('on',x.dataset.act==='what:'+S.draft.what));break;
  case 'addex':{const i=$('#exIn'),v=i.value.trim();if(v&&!S.draft.ex.includes(v))S.draft.ex.push(v);i.value='';$('#dayEx').innerHTML=exChips();break;}
  case 'rmex':S.draft.ex.splice(+arg,1);$('#dayEx').innerHTML=exChips();break;
  case 'rmph':S.draft.photo=null;$('#dayPhBox').innerHTML=phBox();break;
  case 'daysave':{const d=S.draft;d.note=$('#dayNote').value.trim();d.share=$('#dayShare').checked;
   if(!d.what&&!d.ex.length){toast('Elige qué entrenaste o agrega un ejercicio');break;}
   if(!d.what){const ms=[];d.ex.forEach(nm=>{const x=EX.find(z=>z.n===nm);if(x)ms.push(...x.m);});d.what=groupOf(ms);}
   S.cal[S.day]={what:d.what,ex:d.ex,photo:d.photo,note:d.note};
   let msg='Día guardado en tu calendario';
   if(d.share){if(S.calPub){S.posts.unshift({id:'p'+Date.now(),u:'me',k:'photo',media:d.photo,mk:'img',big:d.what,g:0,txt:'Hoy: '+d.what+(d.ex.length?' · '+d.ex.join(', '):''),tr:null,likes:0,cm:[]});msg='Guardado y publicado en Inicio';}
    else msg='Guardado. Tu calendario es privado, no se publicó en Inicio';}
   S.sheet=null;render();toast(msg);break;}
  case 'daydel':delete S.cal[S.day];S.sheet=null;render();toast('Día borrado');break;
  case 'save':{const hh=parseInt($('#hIn').value,10),ww=parseFloat($('#wIn').value);
   if(!isNaN(hh)&&(hh<100||hh>250)){toast('La altura debe estar entre 100 y 250 cm');break;}
   if(!isNaN(ww)&&(ww<30||ww>300)){toast('El peso debe estar entre 30 y 300 kg');break;}
   if(!isNaN(hh))S.h=hh;if(!isNaN(ww))S.w=ww;
   const u=$('#uIn').value.trim();if(u)S.user=u;S.bio=$('#bioIn').value;S.ig=$('#igIn').value.trim();S.tt=$('#ttIn').value.trim();S.sheet=null;render();toast('Perfil actualizado');break;}
  case 'logout':S.sheet=null;S.view='auth';render();break;
 }
});
document.addEventListener('keydown',e=>{if(e.key!=='Enter')return;const id=e.target.id;
 if(id==='msgIn'){e.preventDefault();send();}
 else if(id==='exIn'){e.preventDefault();const b=document.querySelector('[data-act="addex"]');if(b)b.click();}
 else if(id==='cmIn'){e.preventDefault();const b=document.querySelector('[data-act="cmsend"]');if(b)b.click();}});
document.addEventListener('input',e=>{
 const t=e.target;
 if(t.id==='exq'){S.q=t.value;$('#exl').innerHTML=exList();$('#exCt').textContent=exCt();document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('on',!S.q.trim()&&x.dataset.act==='cat:'+S.cat));return;}
 if(t.id==='pcap'){S.np.txt=t.value;$('#pCt').textContent=t.value.length+'/150';return;}
 if(t.id==='un')$('#unCt').textContent=t.value.length+'/20';
 if(t.id==='uIn')$('#uCt').textContent=t.value.length+'/20';
 if(t.id==='bioIn')$('#bCt').textContent=t.value.length+'/250';
});
/* moderación: el prototipo solo simula la detección (archivo con 'sensible' en el nombre). La app real usa un servicio de análisis de imágenes. */
const NSFW=f=>/sensible|nsfw|desnud|xxx/i.test(f.name||'');
function banUser(){S.banned=true;S.sheet=null;endCall();S.view='banned';render();}
V.banned=()=>`<div class="pad" style="text-align:center;padding-top:70px"><div style="color:var(--hot)">${I('shield',64)}</div><h1 style="margin-top:12px">Cuenta suspendida</h1><p class="mut">Se detectó contenido sexual con partes íntimas descubiertas. Las reglas de Forja no lo permiten y tu cuenta fue baneada de inmediato.</p><p class="small mut">Si crees que fue un error, puedes apelar y una persona revisará tu caso.</p><div style="height:14px"></div><button class="btn ghost" data-act="appeal">Apelar (demo: te devuelve a la app)</button></div>`;
document.addEventListener('change',e=>{
 const t=e.target;
 if(t.type==='file'&&t.files&&t.files[0]&&NSFW(t.files[0])){t.value='';banUser();return;}
 if(t.id==='lg'){S.lang=t.value;S.sheet=null;render();return;}
 if(t.id==='pmedia'&&t.files[0]){const f=t.files[0];
  if(f.type.startsWith('video')){S.np.media=URL.createObjectURL(f);S.np.mk='video';renderSheet();}
  else{const r=new FileReader();r.onload=()=>{S.np.media=r.result;S.np.mk='img';renderSheet();};r.readAsDataURL(f);}return;}
 if(t.id==='dayPh'&&t.files[0]){const r=new FileReader();r.onload=()=>{S.draft.photo=r.result;$('#dayPhBox').innerHTML=phBox();};r.readAsDataURL(t.files[0]);return;}
 if(t.id==='progIn'&&t.files[0]){const r=new FileReader();r.onload=()=>{S.photos.unshift(r.result);render();toast('Foto agregada a tu progreso');};r.readAsDataURL(t.files[0]);}
 if(t.id==='coachIn'&&t.files[0]){
  const r=new FileReader();r.onload=()=>{push('coach','m','',r.result);setTimeout(()=>push('coach','t','Recibí tu foto. En la app real la IA la analizará (agenda, rutina o comida) para ajustar tu día. Cuéntame también tus horarios.'),900);};r.readAsDataURL(t.files[0]);t.value='';return;}
 if(t.id==='foodIn'&&t.files[0]){
  if(S.food>=5){toast('Límite de 5 fotos alcanzado');t.value='';return;}
  const r=new FileReader();r.onload=()=>{S.food++;const ct=$('#foodCt');if(ct)ct.textContent=S.food;push('nutri','m','',r.result);
   setTimeout(()=>push('nutri','t','Estimado de ejemplo: '+KCAL[(S.food-1)%3]+'. En la app real la IA analizará tu foto.'),900);};r.readAsDataURL(t.files[0]);t.value='';
 }
});
document.addEventListener('error',e=>{const v=e.target;if(v&&v.tagName==='VIDEO'){const d=document.createElement('div');d.className='pbig';d.textContent='Video guardado. La vista previa no está disponible aquí.';v.replaceWith(d);}},true);
render();
