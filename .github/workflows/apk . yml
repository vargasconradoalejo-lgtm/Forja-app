<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Forja App</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap">
<style>
/* Layout: a phone-sized app shell centred on the page; bottom tab bar like TikTok (Ejercicios, Bandeja, Perfil). */
:root{
  --bg:#eef0f4; --surface:#ffffff; --ink:#12161f; --mut:#5d6675; --line:#dfe3ea;
  --acc:#2b50f0; --acc-ink:#ffffff; --hot:#ff5a36; --off:#d6dbe4; --base:#c3cad7; --mf:#d3d9e4; --ml:#667085; --sk:#e9ecf2; --so:#9aa3b2; --bubble:#e6e9f0;
  --font-d:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  --font-b:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0b0e14; --surface:#151a23; --ink:#eef1f6; --mut:#99a3b4; --line:#262d3a;
    --acc:#7d96ff; --acc-ink:#0b0e14; --hot:#ff7a57; --off:#2a3342; --base:#3a4557; --mf:#2f3a4d; --ml:#8b97ab; --sk:#1a212d; --so:#4a566a; --bubble:#1f2632;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0b0e14; --surface:#151a23; --ink:#eef1f6; --mut:#99a3b4; --line:#262d3a;
  --acc:#7d96ff; --acc-ink:#0b0e14; --hot:#ff7a57; --off:#2a3342; --base:#3a4557; --mf:#2f3a4d; --ml:#8b97ab; --sk:#1a212d; --so:#4a566a; --bubble:#1f2632;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  background:var(--bg); color:var(--ink); font-family:var(--font-b); font-size:14px; line-height:1.45;
  padding-block:12px; padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));
  display:flex; justify-content:center;
}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none;padding:0}
input,textarea,select{font:inherit;color:var(--ink)}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.phone{
  position:relative;width:100%;max-width:400px;height:100%;max-height:820px;display:flex;flex-direction:column;
  background:var(--bg);border:1px solid var(--line);border-radius:28px;overflow:hidden;
}
#screen{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden}
.pad{padding:18px 16px 24px}
h1,h2,h3{font-family:var(--font-d);font-weight:700;letter-spacing:.01em;margin:0;line-height:1.05}
h1{font-size:34px} h2{font-size:26px} h3{font-size:19px;text-transform:uppercase;letter-spacing:.06em}
.mut{color:var(--mut)} .small{font-size:12px}
.ic{display:block;flex:none}
/* tab bar */
#nav{display:flex;border-top:1px solid var(--line);background:var(--surface);padding-bottom:6px}
#nav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:9px 0 5px;color:var(--mut);font-size:11px;font-weight:500}
#nav button.on{color:var(--ink)}
#nav button.on .ic{color:var(--acc)}
#nav button.on span{font-weight:600}
/* generic */
.row{display:flex;align-items:center;gap:10px}
.sp{flex:1;min-width:0}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:46px;border-radius:12px;font-weight:600;background:var(--acc);color:var(--acc-ink)}
.btn.ghost{background:var(--surface);color:var(--ink);border:1px solid var(--line)}
.btn.sm{min-height:36px;width:auto;padding:0 14px;font-size:13px}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.chip{display:inline-block;padding:3px 10px;border-radius:99px;background:var(--bubble);font-size:12px;color:var(--mut)}
.chip.on{background:var(--hot);color:#fff}
.seg{display:flex;background:var(--bubble);border-radius:10px;padding:3px;gap:3px}
.seg button{flex:1;min-height:32px;border-radius:8px;font-size:13px;font-weight:500;color:var(--mut)}
.seg button.on{background:var(--surface);color:var(--ink);font-weight:600}
label.f{display:block;font-size:12px;color:var(--mut);margin:12px 0 4px}
.in{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
textarea.in{resize:none;min-height:84px}
.ct{float:right}
/* auth */
.logo{font-family:var(--font-d);font-weight:700;font-size:44px;letter-spacing:.02em}
.logo b{color:var(--hot);font-weight:700}
.soc{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.soc .btn{min-height:42px;font-size:13px;font-weight:500}
.or{display:flex;align-items:center;gap:10px;color:var(--mut);font-size:12px;margin:16px 0 2px}
.or::before,.or::after{content:"";flex:1;height:1px;background:var(--line)}
/* exercises */
.tabs{display:flex;gap:8px;overflow-x:auto;padding:2px 0 12px;margin:0 -16px;padding-left:16px;padding-right:16px}
.tabs button{flex:none;padding:8px 16px;border-radius:99px;background:var(--surface);border:1px solid var(--line);font-weight:500;font-size:13px}
.tabs button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.exl{display:grid;gap:10px}
.ex{display:flex;gap:12px;align-items:center;text-align:left;width:100%}
.thumb{width:64px;height:64px;border-radius:12px;background:var(--ink);color:var(--bg);display:grid;place-items:center;flex:none}
.ex.done .thumb{background:var(--hot);color:#fff}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.video{aspect-ratio:16/9;max-width:100%;border-radius:14px;background:linear-gradient(135deg,#1d2433,#0b0e14);color:#fff;display:grid;place-items:center;text-align:center;padding:12px}
.video .pl{width:52px;height:52px;border-radius:50%;background:rgba(255,255,255,.16);display:grid;place-items:center;margin:0 auto 8px}
ol.st{margin:10px 0 0;padding-left:20px;display:grid;gap:8px}
/* head bars */
.hd{display:flex;align-items:center;gap:8px;padding:12px 12px 10px;border-bottom:1px solid var(--line);background:var(--surface)}
.ib{width:38px;height:38px;border-radius:50%;display:grid;place-items:center}
.ib:hover{background:var(--bubble)}
/* inbox */
.ch{display:flex;gap:12px;align-items:center;width:100%;text-align:left;padding:12px 0;border-bottom:1px solid var(--line)}
.av{width:48px;height:48px;border-radius:50%;background:var(--bubble);display:grid;place-items:center;flex:none;overflow:hidden;font-family:var(--font-d);font-weight:700;font-size:20px}
.av.ai{background:var(--acc);color:var(--acc-ink)}
.tag{font-size:10px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:2px 6px;border-radius:6px;background:var(--bubble);color:var(--mut);margin-left:6px}
.tag.ai{background:var(--acc);color:var(--acc-ink)}
.ellip{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* chat */
#msgs{flex:1;min-height:0;overflow-y:auto;padding:14px 12px;display:flex;flex-direction:column;gap:8px}
.bb{max-width:80%;padding:9px 12px;border-radius:16px;background:var(--bubble);overflow-wrap:anywhere}
.bb.me{align-self:flex-end;background:var(--acc);color:var(--acc-ink)}
.bb img{display:block;max-width:100%;border-radius:10px}
.bar{display:flex;gap:6px;align-items:center;padding:8px 10px;border-top:1px solid var(--line);background:var(--surface)}
.bar .in{min-height:40px;border-radius:99px}
.cnt{font-size:11px;color:var(--mut);padding:0 12px 6px;background:var(--surface)}
/* profile */
.me-top{display:flex;gap:14px;align-items:center}
.me-av{width:72px;height:72px;border-radius:50%;background:var(--ink);color:var(--bg);display:grid;place-items:center;font-family:var(--font-d);font-size:32px;font-weight:700;flex:none}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}
.stats div{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 6px;text-align:center}
.stats b{display:block;font-family:var(--font-d);font-size:20px;line-height:1}
.stats span{font-size:11px;color:var(--mut)}
.fl{color:var(--hot)}
.vs-top{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;text-align:center}
.vs-top .av{width:60px;height:60px;font-size:24px;margin:0 auto 6px}
.vsn{font-family:var(--font-d);font-size:26px;font-weight:700;color:var(--mut)}
.mrow{margin-top:16px}
.mrow .lab{text-align:center;font-size:12px;color:var(--mut);margin-bottom:6px}
.bars{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.vcell b{display:block;font-family:var(--font-d);font-size:26px;line-height:1;margin-bottom:4px}
.vcell.me{text-align:right}
.bar2{height:10px;border-radius:6px;background:var(--bubble);position:relative;overflow:hidden}
.bar2 i{position:absolute;top:0;bottom:0;border-radius:6px;background:var(--base)}
.bar2.me i{right:0}.bar2.fr i{left:0}
.bar2.lead i{background:var(--hot)}
.dots{display:flex;gap:4px}
.dot{width:14px;height:14px;border-radius:50%;background:var(--off)}
.dot.on{background:var(--hot)}
.bodybox{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px;text-align:center}
.bodybox>div{min-width:0}
.bodybox svg{width:100%;height:auto;display:block}
.silo *{fill:var(--so);stroke:var(--so);stroke-width:2;stroke-linejoin:round}
.sil *{fill:var(--sk)}
.mu path{fill:var(--mf);stroke:var(--ml);stroke-width:.7;stroke-linejoin:round;cursor:pointer}
.mu.on path{fill:var(--hot);fill-opacity:.92}
.det path{fill:none;stroke:var(--ml);stroke-width:.7}
.cap{margin-top:2px}
#mname{text-align:center;margin-top:8px;min-height:20px;font-weight:600}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.two>div{min-width:0}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.tile{aspect-ratio:1/1;max-width:100%;border-radius:10px;background-size:cover;background-position:center;display:grid;place-items:center;font-size:11px;font-weight:600;color:#fff;position:relative;overflow:hidden}
.tile.add{background:var(--surface);border:1.5px dashed var(--line);color:var(--mut);cursor:pointer}
.tile.s1{background:linear-gradient(140deg,#5b6b8c,#2a3347)} .tile.s2{background:linear-gradient(140deg,#8c5b6b,#472a33)} .tile.s3{background:linear-gradient(140deg,#5b8c78,#2a4739)}
/* overlays */
.ov{position:absolute;inset:0;z-index:20;display:flex;flex-direction:column;justify-content:flex-end;background:rgba(5,8,14,.55)}
.sheet{background:var(--bg);border-radius:22px 22px 0 0;padding:16px 16px 22px;max-height:92%;overflow-y:auto}
#call{position:absolute;inset:0;z-index:30;background:linear-gradient(180deg,#141b2c,#05070c);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:24px}
.pulse{width:110px;height:110px;border-radius:50%;background:var(--acc);display:grid;place-items:center;color:var(--acc-ink);box-shadow:0 0 0 0 rgba(125,150,255,.5)}
@media (prefers-reduced-motion:no-preference){.pulse{animation:pl 1.8s infinite}@keyframes pl{70%{box-shadow:0 0 0 26px rgba(125,150,255,0)}100%{box-shadow:0 0 0 0 rgba(125,150,255,0)}}}
.end{width:64px;height:64px;border-radius:50%;background:#e5372b;display:grid;place-items:center;margin-top:10px}
#toast{position:absolute;left:16px;right:16px;bottom:78px;z-index:40;background:var(--ink);color:var(--bg);padding:10px 14px;border-radius:12px;text-align:center;font-size:13px}
#nav button.mid{justify-content:center;padding-top:10px}
#nav .plus{width:46px;height:30px;border-radius:10px;background:var(--acc);color:var(--acc-ink);display:grid;place-items:center}
.feedwrap{position:relative;flex:1;min-height:0}
.feed{position:absolute;inset:0;overflow-y:auto;scroll-snap-type:y mandatory;background:#05070c}
.post{position:relative;height:100%;scroll-snap-align:start;scroll-snap-stop:always;overflow:hidden;color:#fff;background:#05070c}
.pmedia{position:absolute;inset:0;display:grid;place-items:center;cursor:pointer}
.pmedia img,.pmedia video{width:100%;height:100%;object-fit:cover;display:block}
.pshade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.5) 0,rgba(0,0,0,0) 22%,rgba(0,0,0,0) 55%,rgba(0,0,0,.72) 100%);pointer-events:none}
.ptag{position:absolute;top:56px;left:14px;font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:3px 8px;border-radius:6px;background:rgba(0,0,0,.45)}
.pbig{text-align:center;font-family:var(--font-d);font-size:28px;font-weight:700;letter-spacing:.03em;padding:0 40px;text-shadow:0 2px 8px rgba(0,0,0,.4)}
.pinfo{position:absolute;left:14px;right:78px;bottom:16px}
.pinfo p{margin:4px 0 8px;overflow-wrap:anywhere}
.mchip{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:99px;background:rgba(0,0,0,.5);font-size:12px}
.eq{display:inline-flex;gap:2px;align-items:flex-end;height:12px}
.eq i{width:3px;background:#fff;height:5px;border-radius:1px}
.mchip.pl .hint{display:none}
@media (prefers-reduced-motion:no-preference){.mchip.pl .eq i{animation:eq .8s infinite ease-in-out}.mchip.pl .eq i:nth-child(2){animation-delay:.2s}.mchip.pl .eq i:nth-child(3){animation-delay:.4s}@keyframes eq{0%,100%{height:4px}50%{height:12px}}}
.pact{position:absolute;right:10px;bottom:16px;display:grid;gap:14px;justify-items:center}
.pact button{display:grid;justify-items:center;gap:2px;color:#fff;font-size:11px;text-shadow:0 1px 4px rgba(0,0,0,.5)}
.pact button .ic{width:30px;height:30px}
.pact button.on .ic{color:#ff4d6d;fill:#ff4d6d}
.pav{width:42px;height:42px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;font-family:var(--font-d);font-weight:700;font-size:18px;position:relative;margin-bottom:8px}
.pav .fb{position:absolute;bottom:-9px;left:50%;transform:translateX(-50%);width:20px;height:20px;border-radius:50%;background:var(--hot);color:#fff;display:grid;place-items:center;font-size:14px;line-height:1;text-shadow:none}
.ftabs{position:absolute;top:0;left:0;right:0;z-index:5;display:flex;justify-content:center;gap:20px;padding:14px 12px 10px;background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,0))}
.ftabs button{color:rgba(255,255,255,.65);font-weight:600;font-size:15px;padding:4px 2px;border-bottom:2px solid transparent;text-shadow:0 1px 4px rgba(0,0,0,.5)}
.ftabs button.on{color:#fff;border-bottom-color:#fff}
.adcta{display:inline-flex;margin-top:4px;padding:10px 16px;border-radius:10px;background:#fff;color:#111;font-weight:600}
.empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;color:#fff;padding:24px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:8px}
.cal .wd{text-align:center;font-size:11px;color:var(--mut);padding:2px 0}
.cal button{aspect-ratio:1/1;border-radius:10px;display:grid;place-items:center;align-content:center;gap:1px;font-size:13px;background:var(--bubble);position:relative;min-width:0;padding:0}
.cal button.blank{background:none;pointer-events:none}
.cal button.has{background:var(--hot);color:#fff;font-weight:600}
.cal button.rest{background:var(--off)}
.cal button.today{outline:2px solid var(--acc);outline-offset:1px}
.cal button small{font-size:9px;line-height:1;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cal button u{position:absolute;bottom:3px;left:50%;margin-left:-3px;width:6px;height:6px;border-radius:2px;background:var(--acc)}
.cal button.has u{background:#fff}
.cal button i{position:absolute;top:3px;right:4px;width:6px;height:6px;border-radius:50%;background:#fff}
.trk{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.trk button{padding:8px 12px;border-radius:99px;border:1px solid var(--line);background:var(--surface);font-size:13px}
.trk button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.pprev{aspect-ratio:16/9;max-width:100%;border-radius:12px;background:var(--bubble);display:grid;place-items:center;overflow:hidden;text-align:center;color:var(--mut)}
.pprev img,.pprev video{width:100%;height:100%;object-fit:cover}
.cm{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)}
.chip button{margin-left:4px;color:inherit}
@media (max-width:440px){.phone{border-radius:0;border-left:0;border-right:0}}
</style><style>[hidden]{display:none!important}html,body{margin:0}@media (max-width:440px){.phone{max-height:none!important;height:100vh!important;border-radius:0!important}body{padding:0!important}}</style></head><body>

